# Server
PORT=3000

# PostgreSQL
# Use DB_HOST=db when running via Docker Compose
# Use DB_HOST=localhost when running locally outside Docker
DB_HOST=db
DB_PORT=5432
DB_NAME=proyecto_paginas_web
DB_USER=postgres
DB_PASSWORD=your_db_password

# SendGrid — recuperación de contraseña
# SENDGRID_FROM_EMAIL debe ser un remitente verificado en tu cuenta de SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@tudominio.com

# URL pública del frontend (links en correos de reserva/venta)
FRONTEND_URL=http://localhost:8080

# Login allowlisted para el panel de avance del camión (default: managetruck)
# TRACKING_CAMION_USUARIO=managetruck
